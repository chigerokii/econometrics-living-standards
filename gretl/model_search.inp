# Перебор спецификаций ARIMAX в gretl (история команд сессии, апрель 2025)
# Запись истории команд текущей сессии.  Учтите, что для запуска
# этих команд в скрипте, возможно, придется внести некоторые изменения.
open \
  "../data/model_data_logs.xlsx" \
  --coloffset=1
setobs 1 1998 --time-series
# модель 1
arima 1 1 1 ; income grp doctors gini migration naturalpopulationgrowth \
  students 0 --conditional
# модель 2
arima 1 1 1 ; income grp doctors gini migration students 0 --conditional
