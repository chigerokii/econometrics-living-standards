# модель 11
modtest --normality
modtest --autocorr 13
bkw
# модель 4
modtest --normality
modtest --autocorr 3
# модель 24
arima 1 1 1 ; income migration doctors 0 --conditional
modtest --normality
modtest --autocorr 3
modtest 1 --arch
xcorrgm income grp 1
normtest income --all
boxplot income
summary income
corrgm income 5
# модель 25
arima 2 1 1 ; income migration doctors 0 --conditional
xcorrgm grp doctors 1
# модель 26
arima 1 1 1 ; income grp gini students 0 --conditional
modtest --normality
modtest --autocorr 3
modtest 1 --arch
logs income
